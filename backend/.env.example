# Configuração da Aplicação
PORT=3000
NODE_ENV=development

# Origens permitidas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://stgp.fct.unesp.br

# Google Cloud OAuth 2.0 (Client ID Web para Login Google @unesp.br)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Google Sheets API (Conta de Serviço)
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json
GOOGLE_SPREADSHEET_ID=seu-id-da-planilha-aqui
GOOGLE_SHEET_NAME=Respostas

# Configuração de E-mail (SMTP Institucional / Unesp)
SMTP_HOST=smtp.unesp.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rh.fct@unesp.br
SMTP_PASS=sua-senha-ou-app-password
SMTP_FROM="STGP - FCT UNESP <rh.fct@unesp.br>"
EMAIL_NOTIFICACAO_STGP=rh.fct@unesp.br
